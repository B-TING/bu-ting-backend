#!/bin/sh
set -e

# 통합 테스트(@Tag("integration"))는 도커 컨테이너를 띄워 느리다. 훅이 느리면 --no-verify 로 우회하게
# 되므로 여기서는 빠른 단위 테스트만 돌린다. 전체 check(통합 테스트 + 커버리지 게이트)는 CI 가 PR 에서
# 그대로 돌리고, dev 브랜치 보호가 그 상태 검사를 요구한다.
echo "🚀 Running checks before push..."

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    cmd.exe /c gradlew.bat spotlessApply unitTest
    ;;
  *)
    chmod +x ./gradlew
    ./gradlew spotlessApply unitTest
    ;;
esac

if ! git diff --quiet; then
  echo "❌ Spotless changed files. Please review and commit the changes before pushing."
  git status --short
  exit 1
fi

echo "✅ Pre-push checks passed. (통합 테스트와 커버리지 게이트는 CI 의 check 에서 돈다)"
