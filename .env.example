# buting-be 환경변수 템플릿.
#
# 사용법: 이 파일을 `.env`로 복사한 뒤 값을 채운다. `.env`는 git-ignore되며 절대 커밋하지 않는다.
#   cp .env.example .env
# `./gradlew bootRun`이 `.env`를 읽어 환경변수로 주입한다. 패키지 JAR 실행 시엔 프로세스 환경변수로 직접 준다.
#
# 표기: [필수] 없으면 앱이 시작되지 않음 / [선택] 기본값 있음(미설정 시 해당 기능만 비활성) / [비밀] 실제 값은 여기 쓰지 말 것.

# ── Database ──────────────────────────────────────────────
# [필수] 로컬은 docker-compose.local.yml 기준 호스트 포트 5433.
DB_URL=jdbc:postgresql://localhost:5433/buting
DB_USERNAME=buting
DB_PASSWORD=changeme            # [비밀]

# ── AWS S3 (파일 업로드) ───────────────────────────────────
# [선택] 미설정 시 파일 업로드/presigned URL만 실패한다.
S3_BUCKET=                      # 버킷명 (비우면 업로드 비활성)
AWS_REGION=ap-northeast-2
S3_KEY_PREFIX=uploads
S3_MAX_FILE_SIZE=52428800       # 바이트(50MB)
S3_PRESIGNED_URL_EXPIRATION=3600 # 초
# AWS 자격증명: 애플리케이션 코드가 아닌 AWS 기본 자격증명 체인이 읽는다.
#   로컬: 아래 두 값을 설정. EC2: 인스턴스 IAM 롤을 부여하면 아래는 불필요.
AWS_ACCESS_KEY_ID=              # [비밀][선택] 로컬 전용
AWS_SECRET_ACCESS_KEY=          # [비밀][선택] 로컬 전용

# ── OAuth: Google ─────────────────────────────────────────
# [선택] 미설정 시 Google 로그인만 비활성.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=           # [비밀]
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
# 앱 id_token 검증용 허용 audience. 미설정 시 아래 두 클라이언트 ID로 조합된다.
GOOGLE_ALLOWED_AUDIENCES=
GOOGLE_AND_DEBUG_CLIENT_ID=     # 안드로이드 디버그 클라이언트 ID
GOOGLE_AND_RELEASE_CLIENT_ID=   # 안드로이드 릴리스 클라이언트 ID

# ── OAuth: Naver ──────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=            # [비밀]
NAVER_REDIRECT_URI=http://localhost:8080/login/oauth2/code/naver

# ── OAuth: Kakao ──────────────────────────────────────────
KAKAO_REST_API_KEY=            # 카카오 REST API 키(=client-id)
KAKAO_CLIENT_SECRET=            # [비밀]
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao
KAKAO_ALLOWED_AUDIENCES=        # 미설정 시 아래 값으로 조합
KAKAO_AND_DEBUG_CLIENT_ID=

# ── AI (Spring AI + OpenAI, 여행 일정 생성) ────────────────
# [선택] 미설정 시 AI 일정 생성만 실패. 나머지는 기본값.
AI_API_KEY=                     # [비밀] OpenAI API 키
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini

# ── Place APIs (TourAPI / Google Places) ──────────────────
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOURISM_API_KEY=                # [비밀] 공공데이터 서비스키
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1/places
GOOGLE_PLACES_API_KEY=          # [비밀]

# ── Routing (Google Routes, 선택) ─────────────────────────
# [선택] 기본 off. off면 직선 거리로 추정. on이면 한국 내 대중교통 경로만 개선.
ROUTE_GOOGLE_ENABLED=false
ROUTE_GOOGLE_API_KEY=           # 미설정 시 GOOGLE_PLACES_API_KEY로 대체
ROUTE_GOOGLE_BASE_URL=https://routes.googleapis.com/directions/v2
ROUTE_GOOGLE_CONNECT_TIMEOUT_SECONDS=3
ROUTE_GOOGLE_READ_TIMEOUT_SECONDS=5

# ── Travel invite ─────────────────────────────────────────
TRAVEL_INVITE_BASE_URL=https://yourdomain.com/invite

# ── Upload limits ─────────────────────────────────────────
FILE_MAX_SIZE=50MB
FILE_MAX_REQUEST_SIZE=50MB

# ── Admin / Operator ──────────────────────────────────────
# [선택][비밀] 설정하면 이 토큰으로 운영자(ADMIN) 인증이 가능. 비우면 비활성.
ADMIN_TOKEN=

# ── Zone Event (구역 이벤트, 전부 선택·기본값 있음) ────────
# 판정 모드: AUTO(GPS 통과 즉시 성공) / MANUAL / HYBRID(제출 후 검수).
ZONE_EVENT_REVIEW_MODE=AUTO
# 신고 누적 자동 숨김 임계값.
ZONE_EVENT_REPORT_AUTO_HIDE_THRESHOLD=3
# 촬영 시각과 서버 수신 차이가 이 분을 넘으면 AUTO여도 검수로 강등.
ZONE_EVENT_REVIEW_CAPTURED_AT_THRESHOLD_MINUTES=10
# 회차 스케줄러 주기/초기 지연(ms).
ZONE_EVENT_ROUND_SCHEDULER_DELAY_MS=60000
ZONE_EVENT_ROUND_SCHEDULER_INITIAL_DELAY_MS=60000

# ── (미구현) FCM 푸시 ─────────────────────────────────────
# 현재 푸시는 LoggingPushSender 스텁이다. FcmPushSender가 없으므로 push.fcm.enabled를 켜지 말 것.
# 실제 FCM 도입 시 Firebase Admin 자격증명과 함께 이 섹션을 채운다.
# PUSH_FCM_ENABLED=false
